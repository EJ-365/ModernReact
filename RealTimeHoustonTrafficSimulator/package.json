{
  "name": "houston-traffic-simulator",
  "private": true,
  "version": "10.9.0",
  "type": "module",
  "description": "Award-ready 3D Houston metro simulator + marketing site. Created by Ejay Gabriel.",
  "author": "Ejay Gabriel",
  "scripts": {
    "dev": "vite --port 5176 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5176 --strictPort",
    "package:win": "node scripts/package-win.mjs",
    "docs:serve": "vite --port 5176 --strictPort",
    "ci": "npm ci && npm run build",
    "roads:fetch": "node scripts/fetch-osm-roads.mjs",
    "roads:merge": "node scripts/merge-osm-roads.mjs",
    "roads:build": "npm run roads:fetch && npm run roads:merge"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "vite": "^7.2.4"
  }
}
