# Copy to .env.local (never commit secrets)

# FlightAware AeroAPI key (x-apikey) — used for IAH/HOU airport boards + route enrichment
FLIGHTAWARE_API_KEY=

# --- Live traffic (recommended stack) ---
# Primary: Houston TranStar (public RSS works with no key)
#   Incidents + travel times: proxied via /api/transtar/data/rss/*
# Optional authenticated JSON feeds (request access from TranStar):
#   https://traffic.houstontranstar.org/api/api_doc.aspx
# TRANSTAR_SPEED_URL=https://…   # segment speed / travel-time JSON
# TRANSTAR_INCIDENT_URL=https://…
# TRANSTAR_CLOSURE_URL=https://…

# Fallback: TomTom Traffic Flow + Incidents (optional)
# Key MUST enable Traffic Flow + Traffic Incidents in the developer portal.
# Create at https://developer.tomtom.com/
TOMTOM_API_KEY=
