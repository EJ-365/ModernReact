# Copy to .env.local (never commit secrets)

# ——— PAID APIs — leave unset. Hard-disabled in app code. ———
# FLIGHTAWARE_API_KEY=
# TOMTOM_API_KEY=

# ——— Free live stack (no billing) ———
# Weather: Open-Meteo, NWS, NHC, SPC
# Traffic: Houston TranStar public RSS (no key)
# Flights: OpenSky / airplanes.live / adsb.lol / adsbdb / hexdb

# Optional TranStar authenticated JSON feeds (agency access, not a commercial billable API key):
#   https://traffic.houstontranstar.org/api/api_doc.aspx
# TRANSTAR_SPEED_URL=
# TRANSTAR_INCIDENT_URL=
# TRANSTAR_CLOSURE_URL=
